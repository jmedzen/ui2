{
  "name": "ui2",
  "version": "2.8.2",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev -p 8410",
    "dev:https": "next dev -p 8410 --experimental-https",
    "build": "next build",
    "start": "next start -p 8410",
    "lint": "eslint",
    "pretest": "node -e \"const fs=require('fs');fs.mkdirSync('data',{recursive:true});if(!fs.existsSync('data/courses_db.json')&&fs.existsSync('src/data/courses_db.json'))fs.copyFileSync('src/data/courses_db.json','data/courses_db.json')\"",
    "test": "tsx --test tests/*.test.ts",
    "verify": "tsx tests/full-site-verification.ts",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
